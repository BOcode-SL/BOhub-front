AddType application/javascript .mjs

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # www → apex
  RewriteCond %{HTTP_HOST} ^www\.hub\.bocode\.es [NC]
  RewriteRule ^(.*)$ https://hub.bocode.es/$1 [L,R=301]

  # SPA: non-files → index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Hashed build assets — long cache OK
  <FilesMatch "\.(css|js|mjs|webp|png|jpg|jpeg|gif|ico|woff2?|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # SW + workbox must revalidate (override immutable above)
  <FilesMatch "^(sw\.js|workbox-.*\.js)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  # HTML entry — always revalidate
  <Files "index.html">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </Files>
</IfModule>
